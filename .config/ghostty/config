# scroll
# scroll_to_bottom
keybind = ctrl+alt+end=unbind
# scroll_to_top
keybind = ctrl+alt+home=unbind
# scroll_page_up
keybind = ctrl+alt+page_up=unbind
# scroll_page_down
keybind = ctrl+alt+page_down=unbind
# write_scrollback_file:open
keybind = ctrl+alt+super+o=unbind
# write_scrollback_file:paste
keybind = ctrl+alt+super+p=unbind

# font size
keybind = ctrl+equal=unbind
keybind = ctrl+alt+equal=increase_font_size:1
keybind = ctrl+alt+minus=decrease_font_size:1
keybind = ctrl+alt+zero=reset_font_size

# config
keybind = ctrl+comma=unbind
keybind = ctrl+shift+q=unbind

